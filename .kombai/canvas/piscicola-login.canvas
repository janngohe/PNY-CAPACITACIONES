      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root { --ink:#173a34; --muted:#66766f; --teal:#0f6259; --sea:#dbe8df; --paper:#f8f8f3; --line:#dce4dc; --lime:#c4d86b; }\nhtml { background:var(--paper); }\nbody { margin:0; color:var(--ink); background:var(--paper); font-family:'DM Sans',sans-serif; }\n.brand-name, h1, button, label { font-family:'Manrope',sans-serif; }\n.login-page { min-height:100vh; overflow-x:clip; background:radial-gradient(ellipse at 100% 0%, rgba(211,228,216,.58), transparent 35%), var(--paper); }\n.page-header { max-width:1280px; margin:0 auto; padding:22px 24px 0; }\n.brand-mark { width:48px; height:48px; flex:0 0 48px; border:1px solid #8da49a; border-radius:15px 15px 15px 4px; display:flex; align-items:center; justify-content:center; color:#527269; font:600 10px 'DM Sans',sans-serif; letter-spacing:.11em; background:rgba(255,255,255,.48); }\n.brand-name { font-size:11px; line-height:1.45; letter-spacing:.11em; font-weight:800; }\n.login-layout { max-width:1280px; margin:0 auto; padding:33px 24px 36px; }\n.login-form-area { width:100%; max-width:470px; margin:0 auto; }\n.intro { display:flex; align-items:center; justify-content:space-between; gap:7px; min-height:132px; margin-bottom:26px; position:relative; }\n.intro-copy { width:64%; position:relative; z-index:1; }\n.intro h1 { font-size:30px; letter-spacing:-.055em; line-height:1.08; font-weight:700; margin:0 0 11px; }\n.intro p { font-size:13px; line-height:1.55; margin:0; color:#6b7971; max-width:205px; }\n.aperture-small { width:122px; height:122px; flex:0 0 122px; position:relative; margin-right:2px; }\n.aperture-small::before { content:''; position:absolute; inset:-7px 4px 6px -6px; border:1px solid rgba(15,98,89,.46); border-radius:50%; z-index:2; pointer-events:none; }\n.aperture-small::after { content:''; position:absolute; inset:-12px -7px 2px -13px; border:1px solid rgba(15,98,89,.19); border-radius:48% 52% 50% 50%; transform:rotate(-23deg); z-index:2; pointer-events:none; }\n.aperture-small img { position:absolute; inset:0; width:100%; height:100%; border-radius:50%; object-fit:cover; object-position:47% 48%; }\n.photo-desktop { display:none; }\n.login-form { display:flex; flex-direction:column; gap:18px; }\n.field-group { display:flex; flex-direction:column; gap:8px; }\n.field-group label { font-size:13px; font-weight:700; letter-spacing:-.01em; }\n.input-wrap { height:54px; display:flex; align-items:center; position:relative; border:1px solid #d8e1d9; border-radius:12px; background:rgba(255,255,255,.75); transition:border-color .16s ease, box-shadow .16s ease; }\n.input-wrap:focus-within { border-color:#478b7c; box-shadow:0 0 0 3px rgba(71,139,124,.14); }\n.input-wrap input { width:100%; height:100%; padding:0 15px; border:0; outline:0; border-radius:inherit; background:transparent; color:#173a34; font:500 14px 'DM Sans',sans-serif; }\n.input-wrap input::placeholder { color:#a0aaa3; }\n.password-input { padding-right:48px !important; }\n.password-toggle { width:42px; height:42px; position:absolute; right:5px; top:5px; display:flex; align-items:center; justify-content:center; border-radius:9px; color:#66766f; cursor:pointer; }\n.password-toggle:hover { color:#0f6259; background:#edf3ed; }\n.password-toggle:focus-visible, .submit-button:focus-visible { outline:3px solid rgba(15,98,89,.34); outline-offset:3px; }\n.password-toggle i { font-size:18px; line-height:1; }\n.submit-button { min-height:54px; width:100%; margin-top:3px; border:0; border-radius:12px; background:#145f56; color:white; cursor:pointer; font-size:14px; font-weight:700; letter-spacing:.005em; box-shadow:0 8px 16px rgba(20,95,86,.14); transition:background .16s ease, transform .16s ease, box-shadow .16s ease; }\n.submit-button:hover { background:#0e514a; box-shadow:0 10px 18px rgba(20,95,86,.2); transform:translateY(-1px); }\n.form-note { display:flex; justify-content:center; margin-top:18px; color:#718078; font-size:11px; line-height:1.4; }\n.media-desktop { display:none; }\n@media (min-width:900px) {\n .login-page { min-height:100svh; display:flex; flex-direction:column; }\n .page-header { width:100%; box-sizing:border-box; padding:34px 54px 0; }\n .brand-mark { width:58px; height:58px; flex-basis:58px; border-radius:18px 18px 18px 5px; font-size:11px; }\n .brand-name { font-size:13px; letter-spacing:.13em; }\n .login-layout { flex:1; width:100%; box-sizing:border-box; padding:34px 54px 52px; display:grid; grid-template-columns:minmax(390px, .84fr) minmax(480px, 1.16fr); align-items:center; gap:6%; }\n .login-form-area { width:min(100%,470px); margin:0; padding-left:clamp(12px,4vw,76px); }\n .intro { min-height:unset; margin-bottom:39px; display:block; }\n .intro-copy { width:100%; }\n .intro h1 { font-size:43px; margin-bottom:14px; }\n .intro p { max-width:340px; font-size:15px; }\n .aperture-small { display:none; }\n .photo-desktop { display:block; position:relative; min-height:570px; height:min(65vw,660px); max-height:740px; overflow:visible; }\n .photo-disc { width:min(54vw,630px); height:min(54vw,630px); max-width:630px; max-height:630px; position:absolute; top:50%; left:50%; transform:translate(-48%,-50%); border-radius:50%; overflow:hidden; background:#d8e6da; box-shadow:0 20px 52px rgba(26,63,52,.12); }\n .photo-disc img { width:100%; height:100%; object-fit:cover; object-position:45% 52%; }\n .photo-disc::after { content:''; position:absolute; inset:0; background:linear-gradient(145deg, rgba(8,57,50,.02), rgba(7,43,39,.16)); pointer-events:none; }\n .orbit-one, .orbit-two { position:absolute; width:min(56vw,660px); height:min(56vw,660px); max-width:660px; max-height:660px; top:50%; left:50%; transform:translate(-48%,-50%) rotate(-22deg); border:1px solid rgba(15,98,89,.40); border-radius:49% 51% 50% 48%; pointer-events:none; }\n .orbit-two { width:min(60vw,704px); height:min(53vw,620px); border-color:rgba(15,98,89,.17); transform:translate(-46%,-51%) rotate(19deg); }\n .water-line { position:absolute; width:72%; height:65%; top:13%; right:-1%; z-index:2; pointer-events:none; }\n .water-line path { fill:none; stroke:rgba(241,247,239,.8); stroke-width:1.4; }\n .form-note { justify-content:flex-start; margin-top:20px; font-size:12px; }\n}\n@media (max-width:370px) {\n .page-header { padding-left:19px; padding-right:19px; }\n .login-layout { padding-left:19px; padding-right:19px; }\n .intro { gap:3px; }\n .intro h1 { font-size:27px; }\n .aperture-small { width:108px; height:108px; flex-basis:108px; }\n}\n</style>\n<div class=\"login-page min-h-screen\" data-kid=\"1\" data-name=\"login page layout container\">\n    <header aria-label=\"Identidad de la empresa\" class=\"page-header\" data-kid=\"1-1\" data-name=\"page header with brand identity\">\n        <div class=\"flex items-center gap-3\" data-kid=\"1-1-1\" data-name=\"brand logo and name container\">\n            <div aria-label=\"Espacio reservado para el logo de la empresa\" class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"company logo placeholder mark\" role=\"img\">\n                LOGO\n            </div>\n            <div class=\"brand-name\" data-kid=\"1-1-1-2\" data-name=\"company brand name text\">\n                C.I. PISCÍCOLA\n                <br data-kid=\"1-1-1-2-1\"/>\n                NEW YORK\n            </div>\n        </div>\n    </header>\n    <main class=\"login-layout\" data-kid=\"1-2\" data-name=\"main login content area\">\n        <section aria-labelledby=\"login-title\" class=\"login-form-area\" data-kid=\"1-2-1\" data-name=\"login form section\">\n            <div class=\"intro\" data-kid=\"1-2-1-1\" data-name=\"intro area with headline and image\">\n                <div class=\"intro-copy\" data-kid=\"1-2-1-1-1\" data-name=\"intro copy container\">\n                    <h1 data-kid=\"1-2-1-1-1-1\" data-name=\"login page headline\" id=\"login-title\">\n                        Iniciar sesión\n                    </h1>\n                    <p data-kid=\"1-2-1-1-1-2\" data-name=\"login page subtitle text\">\n                        Ingresa tu número de identificación para acceder.\n                    </p>\n                </div>\n                <div aria-hidden=\"true\" class=\"aperture-small\" data-kid=\"1-2-1-1-2\" data-name=\"small decorative underwater fish image circle\">\n                    <img alt=\"Peces de cultivo bajo el agua — fotografía de Nothing Ahead en Pexels\" data-kid=\"1-2-1-1-2-1\" data-name=\"small underwater fish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7188175/pexels-photo-7188175.jpeg?auto=compress&cs=tinysrgb&w=420&q=80\"/>\n                </div>\n            </div>\n            <form class=\"login-form\" data-kid=\"1-2-1-2\" data-name=\"login form\" onsubmit=\"event.preventDefault()\">\n                <div class=\"field-group\" data-kid=\"1-2-1-2-1\" data-name=\"identification number field group\">\n                    <label data-kid=\"1-2-1-2-1-1\" data-name=\"identification number field label\" for=\"identification\">\n                        Número de identificación\n                    </label>\n                    <div class=\"input-wrap\" data-kid=\"1-2-1-2-1-2\" data-name=\"identification number input wrapper\">\n                        <input autocomplete=\"username\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"identification number input field\" id=\"identification\" inputmode=\"numeric\" name=\"identification\" placeholder=\"Ingresa tu número\" required=\"\" type=\"text\"/>\n                    </div>\n                </div>\n                <div class=\"field-group\" data-kid=\"1-2-1-2-2\" data-name=\"password field group\">\n                    <label data-kid=\"1-2-1-2-2-1\" data-name=\"password field label\" for=\"password\">\n                        Contraseña\n                    </label>\n                    <div class=\"input-wrap\" data-kid=\"1-2-1-2-2-2\" data-name=\"password input wrapper with visibility toggle\">\n                        <input autocomplete=\"current-password\" class=\"password-input\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"password input field\" id=\"password\" name=\"password\" placeholder=\"Ingresa tu contraseña\" required=\"\" type=\"password\"/>\n                        <button aria-label=\"Mostrar contraseña\" aria-pressed=\"false\" class=\"password-toggle\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"password visibility toggle button\" data-reason=\"button label, aria-pressed and icon class are rewritten by inline click handler\" onclick=\"const input=document.getElementById('password'); const shown=input.type==='password'; input.type=shown?'text':'password'; this.setAttribute('aria-label',shown?'Ocultar contraseña':'Mostrar contraseña'); this.setAttribute('aria-pressed',shown?'true':'false'); this.querySelector('i').className=shown?'icon-eye-off':'icon-eye';\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"icon-eye\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"password visibility eye icon\" data-reason=\"icon class swapped by inline click handler\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <button class=\"submit-button\" data-kid=\"1-2-1-2-3\" data-name=\"primary login submit button\" type=\"submit\">\n                    Iniciar sesión\n                </button>\n            </form>\n            <p class=\"form-note\" data-kid=\"1-2-1-3\" data-name=\"form footnote text about collaborator access\">\n                Acceso para colaboradores de C.I. Piscícola New York.\n            </p>\n        </section>\n        <div aria-hidden=\"true\" class=\"media-desktop\" data-kid=\"1-2-2\" data-name=\"desktop decorative media section\">\n            <div class=\"photo-disc\" data-kid=\"1-2-2-1\" data-name=\"large circular underwater fish photo with gradient overlay\">\n                <img alt=\"Peces de cultivo bajo el agua — fotografía de Nothing Ahead en Pexels\" data-kid=\"1-2-2-1-1\" data-name=\"large underwater fish photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7188175/pexels-photo-7188175.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                <svg aria-hidden=\"true\" class=\"water-line\" data-kid=\"1-2-2-1-2\" data-name=\"decorative water line SVG over photo\" preserveaspectratio=\"none\" viewbox=\"0 0 420 390\">\n                    <path d=\"M5 260 C 80 185, 122 322, 202 249 S 315 160, 420 208 M3 286 C 80 212, 127 348, 208 274 S 324 186, 423 233\">\n                    </path>\n                </svg>\n            </div>\n            <div class=\"orbit-one\" data-kid=\"1-2-2-2\" data-name=\"outer decorative orbit ring around photo\">\n            </div>\n            <div class=\"orbit-two\" data-kid=\"1-2-2-3\" data-name=\"inner decorative orbit ring around photo\">\n            </div>\n        </div>\n    </main>\n</div>\n",
